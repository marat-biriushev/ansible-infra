---
# ===================================================================
# Copy to vault.yml and encrypt:
#     cp vault.yml.example vault.yml
#     ansible-vault encrypt inventories/test/group_vars/all/vault.yml
# Never commit the decrypted file.
# ===================================================================
vault_postgresql_superuser_password: "CHANGE_ME_superuser"
vault_postgresql_replication_password: "CHANGE_ME_replication"
vault_postgresql_rewind_password: "CHANGE_ME_rewind"
vault_patroni_restapi_password: "CHANGE_ME_restapi"
vault_haproxy_stats_password: "CHANGE_ME_stats"
vault_keepalived_auth_pass: "CHANGE_ME_vrrp"   # max 8 characters
