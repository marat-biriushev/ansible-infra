# {{ ansible_managed }}
# PostgreSQL entry point for the Patroni cluster "{{ pg_cluster_name | default(patroni_scope | default('pg-cluster')) }}"
global
    maxconn {{ haproxy_maxconn }}
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    tcp
    retries 2
    option  tcplog
    option  dontlognull
    timeout connect {{ haproxy_timeout_connect }}
    timeout client  {{ haproxy_timeout_client }}
    timeout server  {{ haproxy_timeout_server }}
    timeout check   {{ haproxy_timeout_check }}

{% if haproxy_stats_enabled %}
listen stats
    mode http
    bind {{ haproxy_bind_address }}:{{ haproxy_stats_port }}
    stats enable
    stats uri {{ haproxy_stats_uri }}
    stats refresh 5s
    stats show-node
    stats auth {{ haproxy_stats_user }}:{{ haproxy_stats_password }}
{% endif %}

# --- read/write: always the current leader ---------------------------
listen postgres_primary
    bind {{ haproxy_bind_address }}:{{ haproxy_primary_port }}
    option httpchk GET /primary
    http-check expect status 200
    default-server inter {{ haproxy_check_interval }} rise {{ haproxy_check_rise }} fall {{ haproxy_check_fall }} maxconn {{ haproxy_default_server_maxconn }} on-marked-down shutdown-sessions
{% for host in groups[haproxy_backend_group] %}
    server {{ host }} {{ hostvars[host].ansible_host | default(hostvars[host].ansible_default_ipv4.address) }}:{{ postgresql_port }} check port {{ patroni_restapi_port }}
{% endfor %}

# --- read-only: healthy replicas, leader used as a last resort -------
listen postgres_replicas
    bind {{ haproxy_bind_address }}:{{ haproxy_replica_port }}
    balance roundrobin
    option httpchk GET /replica
    http-check expect status 200
    default-server inter {{ haproxy_check_interval }} rise {{ haproxy_check_rise }} fall {{ haproxy_check_fall }} maxconn {{ haproxy_default_server_maxconn }}
{% for host in groups[haproxy_backend_group] %}
    server {{ host }} {{ hostvars[host].ansible_host | default(hostvars[host].ansible_default_ipv4.address) }}:{{ postgresql_port }} check port {{ patroni_restapi_port }}
{% endfor %}
