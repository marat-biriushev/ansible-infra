# {{ ansible_managed }}
[Unit]
Description=etcd - distributed reliable key-value store ({{ etcd_cluster_name }})
Documentation=https://etcd.io/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User={{ etcd_user }}
Group={{ etcd_group }}
ExecStart={{ etcd_bin_dir }}/etcd --config-file {{ etcd_conf_dir }}/etcd.conf.yml
Restart=always
RestartSec=5
LimitNOFILE=65536
TimeoutStartSec=0
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
