# {{ ansible_managed }}
name: '{{ inventory_hostname }}'
data-dir: '{{ etcd_data_dir }}'

listen-peer-urls: 'http://{{ etcd_node_ip }}:{{ etcd_peer_port }}'
listen-client-urls: 'http://{{ etcd_node_ip }}:{{ etcd_client_port }},http://127.0.0.1:{{ etcd_client_port }}'
initial-advertise-peer-urls: 'http://{{ etcd_node_ip }}:{{ etcd_peer_port }}'
advertise-client-urls: 'http://{{ etcd_node_ip }}:{{ etcd_client_port }}'

initial-cluster: '{% for host in groups[etcd_group_name] %}{{ host }}=http://{{ hostvars[host].ansible_host | default(hostvars[host].ansible_default_ipv4.address) }}:{{ etcd_peer_port }}{% if not loop.last %},{% endif %}{% endfor %}'
initial-cluster-token: '{{ etcd_initial_cluster_token }}'
initial-cluster-state: '{{ etcd_member_dir.stat.exists | ternary("existing", "new") }}'

heartbeat-interval: {{ etcd_heartbeat_interval }}
election-timeout: {{ etcd_election_timeout }}
snapshot-count: {{ etcd_snapshot_count }}

auto-compaction-mode: '{{ etcd_auto_compaction_mode }}'
auto-compaction-retention: '{{ etcd_auto_compaction_retention }}'
quota-backend-bytes: {{ etcd_quota_backend_bytes }}
max-request-bytes: {{ etcd_max_request_bytes }}

enable-v2: false
log-level: '{{ etcd_log_level }}'
logger: zap
log-outputs: [stderr]
